{
  "name": "@nimblenewt/controller",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Controller: transactional storage contract and domain services (storage adapters are separate modules).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/slice/index.d.ts",
      "default": "./dist/slice/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "test": "node ../../scripts/run-package-tests.mjs --timeout=900000",
    "qualify": "node dist/storage/qualification/report.js"
  },
  "dependencies": {
    "@nimblenewt/registry": "0.0.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/pg": "8.23.1",
    "embedded-postgres": "17.10.0-beta.17"
  }
}
