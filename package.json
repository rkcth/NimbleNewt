{
  "name": "nimblenewt",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "tsc --build",
    "check:deps": "node scripts/check-package-boundaries.mjs",
    "test": "npm run clean && npm run build && npm run check:deps && node --test \"scripts/*.test.mjs\" && npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
